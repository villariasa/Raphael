# Raphael picks a primary AI provider at startup: it tries every free LLM
# API below that has a key set (in the priority order listed), and only
# falls back to local Ollama if none are configured or reachable.
#
# Set as many or as few as you want — each one is optional. Get a free key
# from the linked console, then uncomment and fill it in.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SambaNova — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# Mistral AI — https://console.mistral.ai
MISTRAL_API_KEY=

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=

# xAI (Grok) — https://console.x.ai
XAI_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens
HF_TOKEN=

# Z AI (Zhipu) — https://open.bigmodel.cn
ZHIPU_API_KEY=

# ModelScope — https://modelscope.cn
MODELSCOPE_API_KEY=

# Local Ollama model to use as the fallback provider when no free API key
# is set/reachable (default: llama3.2)
RAPHAEL_MODEL=llama3.2

# Override the local Ollama base URL (default: http://127.0.0.1:11434)
RAPHAEL_OLLAMA_URL=
